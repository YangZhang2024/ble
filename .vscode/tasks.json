{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "STM32: Configure Debug",
            "type": "process",
            "command": "wsl.exe",
            "args": ["--distribution", "Ubuntu", "--cd", "${workspaceFolder}", "--", "bash", "-lc", "cmake --preset Debug"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        },
        {
            "label": "STM32: Build Debug",
            "type": "process",
            "command": "wsl.exe",
            "args": ["--distribution", "Ubuntu", "--cd", "${workspaceFolder}", "--", "bash", "-lc", "cmake --build build/Debug"],
            "options": {"cwd": "${workspaceFolder}"},
            "dependsOn": "STM32: Configure Debug",
            "group": {"kind": "build", "isDefault": true},
            "problemMatcher": ["$gcc"]
        }
    ]
}
